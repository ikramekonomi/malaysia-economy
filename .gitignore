# Rebuildable caches (regenerate: python3 pipeline/build_duckdb.py)
*.duckdb
# Python
__pycache__/
*.pyc
# Scratch / large archives
*.zip

# Raw source documents (PDFs) — CSVs are canonical
sources/*/raw/

# State-source text extraction cache (rebuildable)
sources/*/.textcache/
sources/*/pipeline/__pycache__/
